node_modules/
dist/

# Nuxt build output. `.nuxt` is regenerated by `nuxt prepare` on every install
# (it's the generated types and virtual modules); `.output` is the deployable
# Nitro build. Both are derived from source and would only ever create conflicts.
.nuxt/
.output/

.skills/
# runtime data + uploads live at the repo root only — anchored so it does NOT
# match source dirs like apps/web/src/data (which holds the committed fixture).
/data/
*.sqlite
*.sqlite-*
.env
.env.local
*.log
.DS_Store

.claude/rules/
.claude/commands/
.claude/scripts/
.claude/.agents/
.claude/.pi/
.claude/ecc/
.claude/mcp-configs/
.claude/AGENTS.md
.claude/PLUGIN_SCHEMA_NOTES.md
.claude/marketplace.json
.claude/plugin.json
.claude/README.md

.claude/agents/*
!.claude/agents/api-contract-reviewer.md

.claude/skills/*
!.claude/skills/api-doc/
!.claude/skills/db-migration/
