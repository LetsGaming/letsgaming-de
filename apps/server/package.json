{
  "name": "@lg/server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify server: read API + CMS API + GitHub OAuth + the sync worker host.",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "sync": "tsx src/sync/cli.ts",
    "sync:game-images": "tsx src/sync/game-images-cli.ts",
    "seed:mock": "tsx scripts/seed-mock-data.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "analytics": "tsx src/analytics/cli.ts",
    "test": "node --test --import tsx \"tests/**/*.test.ts\"",
    "analytics:reclassify": "tsx src/analytics/reclassify-cli.ts",
    "analytics:rebuild": "tsx src/analytics/rebuild-cli.ts",
    "analytics:rollup": "tsx src/analytics/rollup-cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@lg/core": "workspace:^",
    "@lg/db": "workspace:^",
    "@lg/sources": "workspace:^",
    "fastify": "^5.12.7",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
