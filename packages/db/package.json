{
  "name": "@lg/db",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "SQLite store: schema + repositories. The single source of truth that accumulates source snapshots (the archive) and upserts the current view.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.rmSync('dist/migrations',{recursive:true,force:true});fs.cpSync('src/migrations','dist/migrations',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:down": "tsx src/migrate-cli.ts",
    "test": "node --test --import tsx ./tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@lg/core": "workspace:^"
  }
}
